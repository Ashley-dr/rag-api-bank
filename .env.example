DB_HOST=db
DB_PORT=5432
DB_NAME=rag_api
DB_USER=postgres
DB_PASSWORD=postgres


ADMIN_API_KEY=252525


OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1
OLLAMA_MODEL=phi3


EMBEDDING_MODEL=Xenova/nomic-embed-text-v1


PORT=3000


TOP_K_RESULTS=5

# --- Live chat with a human (talk to a human) ---
# Mailbox that sends AND receives the "customer is waiting" email (Microsoft Graph)
# MAIL_HUMAN=support@aspacbank.com
# HANDOFF_MAIL_TO=   (optional: deliver to a different inbox)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# TURNSTILE_SECRET_KEY=   (same Cloudflare Turnstile site as the website)
# AGENT_BASE_URL=https://your-api-host   (public URL of THIS API, used in the email link)
# HANDOFF_SECRET=   (long random string; signs the private email links; falls back to ADMIN_API_KEY)
